# Backend-specific .env.example
# These override or supplement the root .env.example when running backend standalone.
# When using docker-compose, the root .env.example is used.

DATABASE_URL=postgresql+asyncpg://namma:changeme@localhost:5432/namma_exodus
ALEMBIC_DATABASE_URL=postgresql+psycopg2://namma:changeme@localhost:5432/namma_exodus
REDIS_URL=redis://localhost:6379/0
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CROWD_SIM_MCP_URL=http://localhost:8001/mcp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=namma-exodus-backend
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
