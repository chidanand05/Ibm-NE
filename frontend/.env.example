# Frontend-specific .env.example
# These override or supplement the root .env.example when running frontend standalone (npm run dev).
# When using docker-compose, the root .env.example is used.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAP_CENTER_LAT=12.9789
NEXT_PUBLIC_MAP_CENTER_LNG=77.5996
NEXT_PUBLIC_MAP_ZOOM=13
