# =============================================================================
# Namma Exodus — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# .env is listed in .gitignore.
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=namma_exodus
POSTGRES_USER=namma
POSTGRES_PASSWORD=changeme

# Async SQLAlchemy connection URL (used by backend)
DATABASE_URL=postgresql+asyncpg://namma:changeme@postgres:5432/namma_exodus

# Sync URL for Alembic migrations only
ALEMBIC_DATABASE_URL=postgresql+psycopg2://namma:changeme@postgres:5432/namma_exodus

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
# Internal Docker network address — not exposed to host
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# ─── MCP Servers ──────────────────────────────────────────────────────────────
# crowd-sim-mcp is a standalone Docker service (internal network only)
CROWD_SIM_MCP_URL=http://crowd-sim-mcp:8001/mcp

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a secure 256-bit secret: openssl rand -hex 32
JWT_SECRET=generate-256-bit-random-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ─── IBM watsonx.ai ───────────────────────────────────────────────────────────
# Regional endpoint options:
#   US South:  https://us-south.ml.cloud.ibm.com
#   EU DE:     https://eu-de.ml.cloud.ibm.com
#   JP TOK:    https://jp-tok.ml.cloud.ibm.com
#   AU SYD:    https://au-syd.ml.cloud.ibm.com
# Match the region where your watsonx.ai project was created.
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id

# ─── Google Gemini ────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# ─── Groq ─────────────────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# ─── OpenTelemetry / Jaeger ───────────────────────────────────────────────────
# Jaeger all-in-one OTLP gRPC endpoint (Docker internal)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=namma-exodus-backend

# ─── Application Settings ─────────────────────────────────────────────────────
# APP_ENV: development | production
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ─── Frontend (Next.js public environment variables) ──────────────────────────
# These are embedded at build time — prefix with NEXT_PUBLIC_ to expose to browser
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAP_CENTER_LAT=12.9789
NEXT_PUBLIC_MAP_CENTER_LNG=77.5996
NEXT_PUBLIC_MAP_ZOOM=13
